<?xml version="1.0"?>
<ruleset name="Order Kanban Board">
	<description>Coding standards for the Order Kanban Board plugin.</description>

	<file>.</file>

	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="order-kanban-board"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="okb"/>
				<element value="OKB"/>
			</property>
		</properties>
	</rule>

	<!-- Capabilities registered by WooCommerce. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_shop_orders"/>
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.6"/>

	<!-- PHPCompatibility (if installed): PHP 7.4 and newer. -->
	<config name="testVersion" value="7.4-"/>
</ruleset>
